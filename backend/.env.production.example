# Production environment variables for Koyeb
# Set these in Koyeb dashboard under your service's Environment Variables

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# CORS - Your Vercel frontend URL
CORS_ORIGINS=https://your-frontend-app.vercel.app

# Frontend URL for email links (password reset, signup invitations)
FRONTEND_URL=https://your-frontend-app.vercel.app

# JWT Configuration
SECRET_KEY=your_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mailjet Email Configuration
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
